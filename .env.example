# Copy this file to ".env" and fill in your real values. Never commit ".env" to git.

# From the Discord Developer Portal > your app > Bot > Token
DISCORD_TOKEN=

# Which AI moderation backend to use: "local" or "huggingface"
# - local: no API/internet call at all — just wordlist.txt + the built-in
#   offline profanity/slur list + OCR. Zero setup, works immediately.
# - huggingface: adds AI-based toxicity scoring on top of the local checks.
#   Free, instant signup, no credit card — just a token from
#   huggingface.co/settings/tokens
MODERATION_BACKEND=local

# Only needed if MODERATION_BACKEND=huggingface
HUGGINGFACE_API_KEY=
HF_MODEL=unitary/toxic-bert
HF_TOXICITY_THRESHOLD=0.7

# Right-click the channel in Discord (with Developer Mode on) > Copy Channel ID
MOD_LOG_CHANNEL_ID=

# Optional: right-click a role > Copy Role ID. If left blank, anyone with
# Kick/Ban/Manage Messages permission can use mod commands.
MOD_ROLE_ID=

AUTO_TIMEOUT_AFTER_WARNINGS=3
AUTO_TIMEOUT_MINUTES=10

# ---- Escalation ladder ----
# How many total warnings trigger each stage. Set any to 0 to disable that stage.
TIMEOUT_AT_WARNINGS=3
TIMEOUT_MINUTES=10
KICK_AT_WARNINGS=5
BAN_AT_WARNINGS=7

# ---- Anti-raid ----
# This many joins within this many seconds = raid detected -> temporary
# verification-level lockdown, and (optionally) auto-kick very new accounts
# that join during the lockdown window.
RAID_JOIN_THRESHOLD=6
RAID_JOIN_WINDOW_SECONDS=30
RAID_LOCKDOWN_MINUTES=15
RAID_NEW_ACCOUNT_HOURS=24

# ---- Spam detection ----
SPAM_MESSAGE_THRESHOLD=5
SPAM_WINDOW_SECONDS=7
MASS_MENTION_THRESHOLD=6

# ---- Exemptions ----
# Comma-separated channel/role IDs that skip auto-moderation entirely.
EXEMPT_CHANNEL_IDS=
EXEMPT_ROLE_IDS=

# ---- Warning decay ----
# Warnings older than this many days stop counting toward the escalation
# ladder. Set to 0 to disable decay (warnings never expire).
WARNING_DECAY_DAYS=0

# ---- Image hash blacklist ----
# Once an image/gif is flagged, its perceptual hash is remembered — reposts
# get blocked instantly even if OCR would otherwise miss them.
IMAGE_HASH_SIMILARITY_THRESHOLD=6

# ---- Nickname/username scanning ----
SCAN_NICKNAMES=true
KICK_ON_BAD_USERNAME=false

# ---- Invite/scam link filter ----
BLOCK_INVITE_LINKS=true
BLOCK_SCAM_LINKS=true
